# Google Places API key (required for real search, omit for mock data)
GOOGLE_API_KEY=

# Gemini API key (required for LLM scoring + synonyms, lexicon fallback if missing)
GEMINI_API_KEY=

# Supabase (required for voting + leaderboard)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Frontend URL for CORS (optional, defaults to localhost:3000 only)
FRONTEND_URL=

# Resend (optional — email notifications: welcome, badge, weekly summary)
RESEND_API_KEY=re_xxxx
EMAIL_FROM=SkillFinder <noreply@skillfinder.fr>

# Cron secret (required — protects the /notifications/weekly-summary endpoint)
CRON_SECRET=

# Sentry (optional — error tracking, get DSN from sentry.io)
SENTRY_DSN=
